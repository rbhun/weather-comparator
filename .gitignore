# Runtime outputs
data/**
!data/coastline/
!data/coastline/*.geojson
!data/skill/
!data/skill/skill_rows.json
!data/.gitkeep
# Runtime live-verification store (fixtures live under contracts/fixtures/verify/)
!data/verify/
!data/verify/.gitkeep
dashboard/data.json
!dashboard/data.json

# Secrets — never commit the real Open-Meteo key or Expedition polar
.env
.env.*
!.env.example
config/polar/**
!config/polar/README.md
!config/polar/.gitkeep

# Python caches and local envs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
# Keep committed fixtures (fabricated polar_52ft.pol is OK to publish)
!contracts/fixtures/**
contracts/fixtures/skeleton_data.json
contracts/fixtures/skeleton_data.js
